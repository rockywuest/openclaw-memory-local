{
  "name": "openclaw-memory-local",
  "version": "2.0.0",
  "description": "Four OpenClaw plugins for persistent, local-first agent memory with behavioral preference learning",
  "author": "Rocky W\u00fcst / FRECH & WUEST GmbH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockywuest/openclaw-memory-local.git"
  },
  "keywords": [
    "openclaw",
    "agent-memory",
    "qdrant",
    "vector-search",
    "local-first",
    "privacy",
    "semantic-memory",
    "agentskills",
    "preference-learning",
    "rlhf"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:verbose": "node --test --test-reporter spec test/*.test.js",
    "test:checkpoint": "node --test test/auto-checkpoint.test.js",
    "test:capture": "node --test test/auto-capture.test.js",
    "test:qdrant": "node --test test/memory-qdrant.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
