{
  "id": "nox-event-bus",
  "displayName": "Nox Event Bus",
  "type": "memory",
  "hooks": ["before_agent_start"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "retentionDays": {
        "type": "number",
        "default": 7,
        "minimum": 1
      },
      "maxEventsInjected": {
        "type": "number",
        "default": 10,
        "minimum": 1,
        "maximum": 50
      }
    }
  }
}
