{
  "id": "nox-cooccurrence",
  "name": "Nox Co-occurrence",
  "version": "1.0.0",
  "description": "Hebbian Learning \u2014 tracks concept co-occurrences for associative memory",
  "author": "Nox AIE",
  "type": "aie-cognitive",
  "entry": "./index.js",
  "hooks": ["before_agent_start"],
  "exports": ["getAssociations", "getCooccurrenceMatrix"],
  "config": {
    "enabled": true,
    "halfLifeHours": 20,
    "maxAssociations": 10,
    "minStrength": 0.3
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
